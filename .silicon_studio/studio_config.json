      "nangate45": [
        "pdk_lib/nangate45/NangateOpenCellLibrary_typical.lib"
      ],
      "asap7": [
        "pdk_lib/asap7/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib",
        "pdk_lib/asap7/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib",
        "pdk_lib/asap7/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib"
      ]
    },
    "fpga_targets": [
      "artix7",
      "ice40",
